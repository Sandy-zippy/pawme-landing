# Copy to .env.local for local dev, or set in GitHub Pages env at build time.
# All values here are PUBLIC (NEXT_PUBLIC_*) — they ship in the static bundle.

# GoHighLevel inbound webhook (public by design)
NEXT_PUBLIC_GHL_INBOUND_WEBHOOK_URL=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
